# ==============================================================================
# OILTRACE DATABASE CONFIGURATION (.env.example)
# Share this template with the Backend Lead.
# NEVER commit real credentials or .env files to GitHub.
# ==============================================================================

# Supabase / PostgreSQL Direct Connection (Backend Only)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Project API Credentials
SUPABASE_URL="https://[YOUR-SUPABASE-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Database Connection Pool Settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=30
