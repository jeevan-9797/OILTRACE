# ==============================================================================
# OILTRACE BACKEND & FRONTEND CONFIGURATION TEMPLATE (.env.example)
# NEVER commit real credentials or .env files to Git.
# ==============================================================================

# Frontend API Configuration (Deployed Production OILTRACE Backend on Render)
VITE_API_BASE_URL="https://oil-trace.onrender.com"

# AI Studio / Gemini API Configuration (if using server-side Gemini integration)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Supabase / PostgreSQL Direct Connection (Backend Only)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Project API Credentials (Backend Only)
SUPABASE_URL="https://[YOUR-SUPABASE-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Database Connection Pool Settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=30
